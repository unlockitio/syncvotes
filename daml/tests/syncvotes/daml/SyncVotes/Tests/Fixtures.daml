-- | What every test here starts from: a provider, the parties it has given accounts, a founded
-- DAO, and the two ways a submission can be refused.
module SyncVotes.Tests.Fixtures where

import Daml.Script
import qualified DA.Text as T
import SyncVotes.Account (Account (..), Account_CreateDAO (..))
import SyncVotes.Governance (DAO (..), Member (..))
import SyncVotes.Types (Rule (..), Basis (..), Threshold (..), Settings (..))

-- | A rule that decides nothing by itself: a simple majority of the whole vote, no quorum, no
-- early settlement, ballots that cannot change. Tests that care about a rule set their own.
openRule : Rule
openRule = Rule with
  basis = OfAll; threshold = Majority; quorum = 0; early = False
  changeable = False; secret = False

openSettings : Settings
openSettings = Settings with rule = openRule; votingDays = 1

-- | A DAO as a test finds it: who signs it, who founded it, and the founder's membership.
data Founded = Founded with
    provider : Party
    founder : Party
    account : ContractId Account
    dao : ContractId DAO
    member : ContractId Member

-- | A party with an account on this provider.
onboard : Party -> Text -> Script (Party, ContractId Account)
onboard provider name = do
  user <- allocateParty name
  account <- submit provider do createCmd Account with provider; user
  pure (user, account)

-- | A DAO whose founder holds its only share, under the rules given.
foundDAOWithSettings : Bool -> Settings -> Settings -> Script Founded
foundDAOWithSettings equal rules decisions = do
  provider <- allocateParty "provider"
  (founder, account) <- onboard provider "founder"
  dao <- submit founder do
    exerciseCmd account Account_CreateDAO with
      id = "dao"; daoName = "Test DAO"; description = ""; image = None
      equal; rules; decisions; shares = [(founder, 1)]; more = []
      actorPays = False; public = True; featuredAppRight = None
  (member, _) <- assertSingleResult "founder's founding membership" =<< query @Member founder
  pure Founded with provider; founder; account; dao; member

-- | The DAO most tests want: one member, one unit, one vote by simple majority.
foundOneMemberDAO : Script Founded
foundOneMemberDAO = foundDAOWithSettings True openSettings openSettings

-- | Require a visible live contract. The label identifies the expectation if it is absent.
assertLiveContract : (Template t, HasEnsure t) => Text -> Party -> ContractId t -> Script t
assertLiveContract label reader cid = do
  result <- queryContractId reader cid
  case result of
    Some contract -> pure contract
    None -> abort ("Expected live " <> label <> " contract")

-- | Require that the contract has been consumed or archived.
assertArchivedContract : (Template t, HasEnsure t) => Text -> Party -> ContractId t -> Script ()
assertArchivedContract label reader cid = do
  result <- queryContractId reader cid
  case result of
    None -> pure ()
    Some _ -> abort ("Expected archived " <> label <> " contract")

assertPresent : Text -> Optional a -> Script a
assertPresent label result = case result of
  Some value -> pure value
  None -> abort ("Expected " <> label)

assertAbsent : Text -> Optional a -> Script ()
assertAbsent label result = case result of
  None -> pure ()
  Some _ -> abort ("Expected no " <> label)

assertSingleResult : Text -> [a] -> Script a
assertSingleResult label results = case results of
  [one] -> pure one
  _ -> abort ("Expected exactly one " <> label <> "; found " <> show (length results))

assertSingleMatching : Text -> (a -> Bool) -> [a] -> Script a
assertSingleMatching label predicate results = assertSingleResult label (filter predicate results)

assertQueryCount : Text -> Int -> [a] -> Script ()
assertQueryCount label expected results =
  assertMsg ("Expected " <> show expected <> " " <> label <> "; found " <> show (length results))
    (length results == expected)

assertEquals : Eq a => Text -> a -> a -> Script ()
assertEquals label expected actual = assertMsg ("Expected " <> label <> " to equal expected value") (actual == expected)

assertCondition : Text -> Bool -> Script ()
assertCondition label condition = assertMsg ("Expected " <> label) condition

-- | A submission that must be refused, with the words the contract says when it refuses. A
-- refusal for any other reason is as much a failure as acceptance: it would leave the rule
-- under test unproven.
refuses : Party -> Text -> Commands a -> Script ()
refuses party said cmds = trySubmit party cmds >>= because said

-- | As `refuses`, for a choice that several parties must authorise together.
refusesAll : [Party] -> Text -> Commands a -> Script ()
refusesAll actors said cmds = trySubmit (actAs actors) cmds >>= because said

-- | An expected rejection must include the named reason; success or a different error fails.
because : Text -> Either SubmitError a -> Script ()
because said outcome = case outcome of
  Right _ -> abort ("The ledger accepted what it must refuse: " <> said)
  Left err -> do
    let reason = show err
    assertMsg
      ("Refused, but not for \"" <> said <> "\"; it said: " <> reason)
      (said `T.isInfixOf` reason)

-- | A text of `n` characters, for the lengths the ledger refuses.
long : Int -> Text
long n = T.implode (map (const "x") [1 .. n])
