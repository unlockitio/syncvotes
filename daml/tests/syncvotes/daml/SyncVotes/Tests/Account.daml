-- | A party's profile and the rules under which it may found a DAO.
module SyncVotes.Tests.Account where

import Daml.Script
import SyncVotes.Account (Account_CreateDAO (..), Account_SetProfile (..), Profile (..))
import SyncVotes.Governance (DAO (..), Proposal (..))
import qualified SyncVotes.Tests.Fixtures as Fixtures
import SyncVotes.Types (Outcome (..), Effect (..))

-- | The provider can archive an account, the founder cannot, and its DAO remains live.
archiveAccount : Script ()
archiveAccount = script do
  f <- Fixtures.foundOneMemberDAO
  live <- Fixtures.assertLiveContract "account" f.provider f.account
  assert (live.user == f.founder)
  trySubmit (actAs f.founder <> readAs f.provider) (do
    exerciseCmd f.account Archive) >>= Fixtures.because "requires authorizers"
  _ <- Fixtures.assertLiveContract "account" f.provider f.account
  submit f.provider do exerciseCmd f.account Archive
  Fixtures.assertArchivedContract "account" f.provider f.account
  dao <- Fixtures.assertLiveContract "DAO" f.founder f.dao
  assert (dao.creator == f.founder)

-- | Replacing a profile consumes the previous one and leaves exactly the updated profile.
profileReplacement : Script ()
profileReplacement = script do
  f <- Fixtures.foundOneMemberDAO
  first <- submit f.founder do
    exerciseCmd f.account Account_SetProfile with
      name = "Founder"; avatar = None; bio = "First"; previous = None
  original <- Fixtures.assertLiveContract "original profile" f.founder first
  Fixtures.assertEquals "original profile name" "Founder" original.name
  Fixtures.assertEquals "original profile bio" "First" original.bio
  next <- submit f.founder do
    exerciseCmd f.account Account_SetProfile with
      name = "Updated"; avatar = Some "https://example.org/avatar.png"
      bio = "Second"; previous = Some first
  Fixtures.assertArchivedContract "original profile" f.founder first
  updated <- Fixtures.assertLiveContract "updated profile" f.founder next
  Fixtures.assertEquals "updated profile user" f.founder updated.user
  Fixtures.assertEquals "updated profile bio" "Second" updated.bio
  (_, only) <- Fixtures.assertSingleResult "updated profile" =<< query @Profile f.founder
  assert (only.name == "Updated")

-- | Invalid names or avatars, another party's profile, and provider-only changes are refused.
profileRefusals : Script ()
profileRefusals = script do
  f <- Fixtures.foundOneMemberDAO
  (other, otherAccount) <- Fixtures.onboard f.provider "other"
  theirs <- submit other do
    exerciseCmd otherAccount Account_SetProfile with
      name = "Other"; avatar = None; bio = ""; previous = None
  Fixtures.refuses f.founder "A profile needs a name" do
    exerciseCmd f.account Account_SetProfile with
      name = ""; avatar = None; bio = ""; previous = None
  Fixtures.refuses f.founder "A name of one to 60 characters" do
    exerciseCmd f.account Account_SetProfile with
      name = Fixtures.long 61; avatar = None; bio = ""; previous = None
  Fixtures.refuses f.founder "A name of one to 60 characters" do
    exerciseCmd f.account Account_SetProfile with
      name = "Valid"; avatar = Some "http://insecure.example"; bio = ""; previous = None
  trySubmit (actAs f.founder <> readAs other) (do
    exerciseCmd f.account Account_SetProfile with
      name = "Valid"; avatar = None; bio = ""; previous = Some theirs)
    >>= Fixtures.because "Not this party's profile"
  Fixtures.refuses f.provider "requires authorizers" do
    exerciseCmd f.account Account_SetProfile with
      name = "Provider"; avatar = None; bio = ""; previous = None
  retained <- Fixtures.assertLiveContract "other profile" other theirs
  assert (retained.name == "Other")
  Fixtures.assertQueryCount "founder profiles after refusals" 0 =<< query @Profile f.founder

-- | Founding creates a DAO with the requested rules and a single founder membership.
founding : Script ()
founding = script do
  f <- Fixtures.foundOneMemberDAO
  dao <- Fixtures.assertLiveContract "DAO" f.founder f.dao
  member <- Fixtures.assertLiveContract "founder membership" f.founder f.member
  Fixtures.assertEquals "DAO name" "Test DAO" dao.name
  Fixtures.assertEquals "DAO members" 1 dao.members
  Fixtures.assertEquals "DAO units" 1 dao.units
  Fixtures.assertEquals "DAO voting rules" Fixtures.openSettings dao.rules
  Fixtures.assertEquals "DAO decision rules" Fixtures.openSettings dao.decisions
  Fixtures.assertEquals "founder member party" f.founder member.party
  Fixtures.assertEquals "founder member share" 1 member.share

-- | Extra founding shares become a proposal while initial DAO units belong to the founder.
foundingWithMore : Script ()
foundingWithMore = script do
  f <- Fixtures.foundOneMemberDAO
  (joiner, _) <- Fixtures.onboard f.provider "joiner"
  next <- submit f.founder do
    exerciseCmd f.account Account_CreateDAO with
      id = "batch"; daoName = "Batch DAO"; description = ""; image = None
      equal = False; rules = Fixtures.openSettings; decisions = Fixtures.openSettings
      shares = [(f.founder, 2)]; more = [(joiner, 3)]
      actorPays = True; public = False; featuredAppRight = None
  dao <- Fixtures.assertLiveContract "batch DAO" f.founder next
  Fixtures.assertEquals "batch DAO members" 1 dao.members
  Fixtures.assertEquals "batch DAO units" 2 dao.units
  Fixtures.assertCondition "batch DAO unequal shares" (not dao.equal)
  proposals <- query @Proposal f.provider
  assert (any (\(_, p) -> p.id == "batch-founding" && p.outcome == Some Passed
                    && p.action == SetShares [(joiner, 3)]) proposals)

-- | Bad names, settings or founding shares and unauthorized creation leave no extra DAO.
foundingRefusals : Script ()
foundingRefusals = script do
  f <- Fixtures.foundOneMemberDAO
  let create name shares more rules = exerciseCmd f.account Account_CreateDAO with
        id = "rejected"; daoName = name; description = ""; image = None
        equal = True; rules; decisions = Fixtures.openSettings; shares; more
        actorPays = False; public = True; featuredAppRight = None
  Fixtures.refuses f.founder "A DAO needs a name" do
    create "" [(f.founder, 1)] [] Fixtures.openSettings
  Fixtures.refuses f.founder "A name of one to 60 characters" do
    create (Fixtures.long 61) [(f.founder, 1)] [] Fixtures.openSettings
  Fixtures.refuses f.founder "The settings' numbers are out of range" do
    create "Valid" [(f.founder, 1)] [] (Fixtures.openSettings with votingDays = 0)
  Fixtures.refuses f.founder "The founding shares must be whole" do
    create "Valid" [(f.founder, 1)] [(f.founder, 1)] Fixtures.openSettings
  Fixtures.refuses f.founder "The first batch is one to a batch" do
    create "Valid" [] [(f.founder, 1)] Fixtures.openSettings
  Fixtures.refuses f.founder "The founding shares are all positive" do
    create "Valid" [(f.founder, 0)] [] Fixtures.openSettings
  (other, _) <- Fixtures.onboard f.provider "other"
  Fixtures.refuses f.founder "The founder holds a share" do
    create "Valid" [(other, 1)] [] Fixtures.openSettings
  Fixtures.refuses f.provider "requires authorizers" do
    create "Valid" [(f.founder, 1)] [] Fixtures.openSettings
  daos <- query @DAO f.provider
  Fixtures.assertQueryCount "DAOs after rejected founding" 1 daos
