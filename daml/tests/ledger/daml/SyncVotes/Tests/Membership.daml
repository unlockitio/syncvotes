-- | A membership is the door a member proposes, votes and comments through, and the DAO's
-- authority is what opens and closes it.
module SyncVotes.Tests.Membership where

import Daml.Script
import SyncVotes.Account (Account_CreateDAO (..))
import SyncVotes.Governance (Member (..), Member_Remove (..), Member_Reshare (..), Member_Comment (..), Member_Propose (..), Comment (..))
import qualified SyncVotes.Tests.Fixtures as Fixtures
import SyncVotes.Types (Effect (..))

-- | Creator and provider together reshare then remove a member, consuming each old membership.
removeAndReshare : Script ()
removeAndReshare = script do
  f <- Fixtures.foundDAOWithSettings False Fixtures.openSettings Fixtures.openSettings
  reshared <- submit (actAs [f.provider, f.founder]) do
    exerciseCmd f.member Member_Reshare with share = 5
  Fixtures.assertArchivedContract "membership" f.founder f.member
  bigger <- Fixtures.assertLiveContract "reshared membership" f.founder reshared
  Fixtures.assertEquals "reshared units" 5 bigger.share
  Fixtures.assertEquals "reshared party" f.founder bigger.party
  assert (bigger.shareSince >= bigger.since)
  submit (actAs [f.provider, f.founder]) do
    exerciseCmd reshared Member_Remove
  Fixtures.assertArchivedContract "reshared membership" f.founder reshared
  Fixtures.assertQueryCount "remaining memberships" 0 =<< query @Member f.founder

-- | Either authority alone and a zero-share reshare are refused; the member retains one share.
membershipRefusals : Script ()
membershipRefusals = script do
  f <- Fixtures.foundOneMemberDAO
  Fixtures.refuses f.provider "requires authorizers" do exerciseCmd f.member Member_Remove
  Fixtures.refuses f.founder "requires authorizers" do exerciseCmd f.member Member_Remove
  Fixtures.refuses f.provider "requires authorizers" do
    exerciseCmd f.member Member_Reshare with share = 2
  -- A membership holds units; none is no membership, and `Member_Remove` is how one leaves.
  Fixtures.refusesAll [f.provider, f.founder] "Template precondition violated" do
    exerciseCmd f.member Member_Reshare with share = 0
  intact <- Fixtures.assertLiveContract "intact membership" f.founder f.member
  assert (intact.share == 1)

-- | An outsider cannot see or use this DAO's membership, even after founding another DAO.
outsidersSeeNoMembership : Script ()
outsidersSeeNoMembership = script do
  f <- Fixtures.foundOneMemberDAO
  (other, otherAccount) <- Fixtures.onboard f.provider "other"
  Fixtures.assertQueryCount "outsider-visible memberships" 0 =<< query @Member other
  Fixtures.refuses other "Could not find contract" do
    exerciseCmd f.member Member_Comment with
      proposalId = "p"; cid = "c"; body = "An outsider's word"
  Fixtures.refuses other "Could not find contract" do
    exerciseCmd f.member Member_Propose with
      dao = f.dao; pid = "p"; title = "An outsider's proposal"; description = ""
      action = Signal; rule = None; votingDays = None; featuredAppRight = None
  -- Nor does an account of its own let it in.
  theirDao <- submit other do
    exerciseCmd otherAccount Account_CreateDAO with
      id = "other-dao"; daoName = "Other DAO"; description = ""; image = None
      equal = True; rules = Fixtures.openSettings; decisions = Fixtures.openSettings
      shares = [(other, 1)]; more = []; actorPays = False
      public = True; featuredAppRight = None
  (theirMember, _) <- Fixtures.assertSingleResult "other DAO membership" =<< query @Member other
  -- Even with the other DAO in view, its own membership is no standing there.
  trySubmit (actAs other <> readAs f.provider) (do
    exerciseCmd theirMember Member_Propose with
      dao = f.dao; pid = "p"; title = "Across DAOs"; description = ""
      action = Signal; rule = None; votingDays = None; featuredAppRight = None)
    >>= Fixtures.because "Not this member's DAO"
  comments <- query @Comment f.provider
  assert (null comments)

-- | A member posts two comments without consuming membership; both record the author and DAO.
commenting : Script ()
commenting = script do
  f <- Fixtures.foundOneMemberDAO
  comment <- submit f.founder do
    exerciseCmd f.member Member_Comment with
      proposalId = "signal"; cid = "c1"; body = "A word on it"
  said <- Fixtures.assertLiveContract "comment" f.founder comment
  Fixtures.assertEquals "comment author" f.founder said.author
  Fixtures.assertEquals "comment body" "A word on it" said.body
  Fixtures.assertEquals "comment DAO" "dao" said.daoId
  Fixtures.assertEquals "comment proposal" "signal" said.proposalId
  -- A comment is nonconsuming: the membership stays, and a second word is a second comment.
  member <- Fixtures.assertLiveContract "membership" f.founder f.member
  assert (member.share == 1)
  _ <- submit f.founder do
    exerciseCmd f.member Member_Comment with
      proposalId = "signal"; cid = "c2"; body = "And another"
  comments <- query @Comment f.founder
  Fixtures.assertQueryCount "comments" 2 comments

-- | Provider-only archive is refused; joint authority removes the membership.
archiveMember : Script ()
archiveMember = script do
  f <- Fixtures.foundOneMemberDAO
  live <- Fixtures.assertLiveContract "membership" f.founder f.member
  assert (live.share == 1)
  Fixtures.refuses f.provider "requires authorizers" do exerciseCmd f.member Archive
  _ <- Fixtures.assertLiveContract "membership" f.founder f.member
  submit (actAs [f.provider, f.founder]) do exerciseCmd f.member Archive
  Fixtures.assertArchivedContract "membership" f.founder f.member
  Fixtures.assertQueryCount "remaining memberships" 0 =<< query @Member f.founder

-- | Provider-only archive is refused; joint authority removes the comment.
archiveComment : Script ()
archiveComment = script do
  f <- Fixtures.foundOneMemberDAO
  cid <- submit f.founder do
    exerciseCmd f.member Member_Comment with
      proposalId = "p"; cid = "c"; body = "Recorded"
  live <- Fixtures.assertLiveContract "comment" f.founder cid
  assert (live.body == "Recorded")
  trySubmit (actAs f.provider <> readAs f.founder) (do
    exerciseCmd cid Archive) >>= Fixtures.because "requires authorizers"
  _ <- Fixtures.assertLiveContract "comment" f.founder cid
  submit (actAs [f.provider, f.founder]) do exerciseCmd cid Archive
  Fixtures.assertArchivedContract "comment" f.founder cid
  Fixtures.assertQueryCount "remaining comments" 0 =<< query @Comment f.founder

-- | Empty, oversized and provider-authored comments are refused without creating any comment.
commentRefusals : Script ()
commentRefusals = script do
  f <- Fixtures.foundOneMemberDAO
  Fixtures.refuses f.founder "A comment of one to 5000 characters" do
    exerciseCmd f.member Member_Comment with
      proposalId = "signal"; cid = "c"; body = ""
  Fixtures.refuses f.founder "A comment of one to 5000 characters" do
    exerciseCmd f.member Member_Comment with
      proposalId = "signal"; cid = "c"; body = Fixtures.long 5001
  Fixtures.refuses f.provider "requires authorizers" do
    exerciseCmd f.member Member_Comment with
      proposalId = "signal"; cid = "c"; body = "The provider's word"
  comments <- query @Comment f.provider
  assert (null comments)
