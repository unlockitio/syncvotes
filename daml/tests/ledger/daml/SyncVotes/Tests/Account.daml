-- | A party's profile and the rules under which it may found a DAO.
module SyncVotes.Tests.Account where

import Daml.Script
import SyncVotes.Account
import SyncVotes.Governance
import SyncVotes.Tests.Fixtures
import SyncVotes.Types

profileReplacement : Script ()
profileReplacement = script do
  f <- found
  first <- submit f.founder do
    exerciseCmd f.account Account_SetProfile with
      name = "Founder"; avatar = None; bio = "First"; previous = None
  Some original <- queryContractId f.founder first
  assert (original.name == "Founder" && original.bio == "First")
  next <- submit f.founder do
    exerciseCmd f.account Account_SetProfile with
      name = "Updated"; avatar = Some "https://example.org/avatar.png"
      bio = "Second"; previous = Some first
  None <- queryContractId f.founder first
  Some updated <- queryContractId f.founder next
  assert (updated.user == f.founder && updated.bio == "Second")
  [(_, only)] <- query @Profile f.founder
  assert (only.name == "Updated")

profileRefusals : Script ()
profileRefusals = script do
  f <- found
  (other, otherAccount) <- onboard f.provider "other"
  theirs <- submit other do
    exerciseCmd otherAccount Account_SetProfile with
      name = "Other"; avatar = None; bio = ""; previous = None
  refuses f.founder "A profile needs a name" do
    exerciseCmd f.account Account_SetProfile with
      name = ""; avatar = None; bio = ""; previous = None
  refuses f.founder "A name of one to 60 characters" do
    exerciseCmd f.account Account_SetProfile with
      name = long 61; avatar = None; bio = ""; previous = None
  refuses f.founder "A name of one to 60 characters" do
    exerciseCmd f.account Account_SetProfile with
      name = "Valid"; avatar = Some "http://insecure.example"; bio = ""; previous = None
  trySubmit (actAs f.founder <> readAs other) (do
    exerciseCmd f.account Account_SetProfile with
      name = "Valid"; avatar = None; bio = ""; previous = Some theirs)
    >>= because "Not this party's profile"
  refuses f.provider "requires authorizers" do
    exerciseCmd f.account Account_SetProfile with
      name = "Provider"; avatar = None; bio = ""; previous = None
  Some retained <- queryContractId other theirs
  assert (retained.name == "Other")
  [] <- query @Profile f.founder
  pure ()

founding : Script ()
founding = script do
  f <- found
  Some dao <- queryContractId f.founder f.dao
  Some member <- queryContractId f.founder f.member
  assert (dao.name == "Test DAO" && dao.members == 1 && dao.units == 1)
  assert (dao.rules == openSettings && dao.decisions == openSettings)
  assert (member.party == f.founder && member.share == 1)

foundingWithMore : Script ()
foundingWithMore = script do
  f <- found
  (joiner, _) <- onboard f.provider "joiner"
  next <- submit f.founder do
    exerciseCmd f.account Account_CreateDAO with
      id = "batch"; daoName = "Batch DAO"; description = ""; image = None
      equal = False; rules = openSettings; decisions = openSettings
      shares = [(f.founder, 2)]; more = [(joiner, 3)]
      actorPays = True; public = False; featuredAppRight = None
  Some dao <- queryContractId f.founder next
  assert (dao.members == 1 && dao.units == 2 && not dao.equal)
  proposals <- query @Proposal f.provider
  assert (any (\(_, p) -> p.id == "batch-founding" && p.outcome == Some Passed
                    && p.action == SetShares [(joiner, 3)]) proposals)

foundingRefusals : Script ()
foundingRefusals = script do
  f <- found
  let create name shares more rules = exerciseCmd f.account Account_CreateDAO with
        id = "rejected"; daoName = name; description = ""; image = None
        equal = True; rules; decisions = openSettings; shares; more
        actorPays = False; public = True; featuredAppRight = None
  refuses f.founder "A DAO needs a name" do
    create "" [(f.founder, 1)] [] openSettings
  refuses f.founder "A name of one to 60 characters" do
    create (long 61) [(f.founder, 1)] [] openSettings
  refuses f.founder "The settings' numbers are out of range" do
    create "Valid" [(f.founder, 1)] [] (openSettings with votingDays = 0)
  refuses f.founder "The founding shares must be whole" do
    create "Valid" [(f.founder, 1)] [(f.founder, 1)] openSettings
  refuses f.founder "The first batch is one to a batch" do
    create "Valid" [] [(f.founder, 1)] openSettings
  refuses f.founder "The founding shares are all positive" do
    create "Valid" [(f.founder, 0)] [] openSettings
  (other, _) <- onboard f.provider "other"
  refuses f.founder "The founder holds a share" do
    create "Valid" [(other, 1)] [] openSettings
  refuses f.provider "requires authorizers" do
    create "Valid" [(f.founder, 1)] [] openSettings
  daos <- query @DAO f.provider
  assert (length daos == 1)
