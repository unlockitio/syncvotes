-- | Passed proposals change ledger state only through the DAO; progress and authority are checked
-- on each execution, including intermediate share batches.
module SyncVotes.Tests.Execution where

import Daml.Script
import DA.Time (addRelTime, days)
import SyncVotes.Account (Account_CreateDAO (..))
import SyncVotes.Governance (DAO (..), DAO_Execute (..), DAO_BeginDissolving (..), Member (..), Member_Propose (..), Member_Cast (..), Member_Vote (..), Proposal (..), Proposal_Tally (..), Proposal_Advance (..))
import qualified SyncVotes.Tests.Fixtures as Fixtures
import SyncVotes.Types (Effect (..), Vote (..), Outcome (..), Settings (..), Basis (..), Threshold (..))

propose : Fixtures.Founded -> ContractId DAO -> ContractId Member -> Text -> Effect -> Script (ContractId Proposal)
propose f dao member pid action = submit f.founder do
  exerciseCmd member Member_Propose with
    dao; pid; title = "Change"; description = ""; action
    rule = None; votingDays = None; featuredAppRight = None

archiveGovernance : Script ()
archiveGovernance = script do
  f <- Fixtures.found
  proposal <- propose f f.dao f.member "archive" Signal
  Some p <- queryContractId f.provider proposal
  ballot <- submit f.founder do
    exerciseCmd f.member Member_Vote with
      proposalId = p.id; closesAt = p.closesAt; changeable = False; vote = Yes
      previous = None; featuredAppRight = None
  [(member, _)] <- query @Member f.founder
  modern <- submit f.founder do
    exerciseCmd member Member_Cast with
      proposalId = "second"; closesAt = p.closesAt; changeable = False; vote = No
      previous = None; previousV1 = None; featuredAppRight = None
  Some old <- queryContractId f.provider ballot
  Some new <- queryContractId f.provider modern
  assert (old.voter == f.founder && new.voter == f.founder)
  trySubmit (actAs f.provider <> readAs f.founder) (do
    exerciseCmd modern Archive) >>= Fixtures.because "requires authorizers"
  Some _ <- queryContractId f.provider modern
  submit (actAs [f.provider, f.founder]) do exerciseCmd ballot Archive
  submit (actAs [f.provider, f.founder]) do exerciseCmd modern Archive
  submit (actAs [f.provider, f.founder]) do exerciseCmd proposal Archive
  submit (actAs [f.provider, f.founder]) do exerciseCmd f.dao Archive
  None <- queryContractId f.provider ballot
  None <- queryContractId f.provider modern
  None <- queryContractId f.provider proposal
  None <- queryContractId f.provider f.dao
  [(survivorId, survivor)] <- query @Member f.founder
  assert (survivorId /= member && survivor.party == f.founder)

-- | Carries a proposal with the founder's single vote and settles it after the deadline.
passWith : Fixtures.Founded -> ContractId Member -> ContractId Proposal -> Vote -> Outcome -> Script (ContractId Proposal)
passWith f member proposal vote outcome = do
  Some p <- queryContractId f.provider proposal
  ballot <- submit f.founder do
    exerciseCmd member Member_Cast with
      proposalId = p.id; closesAt = p.closesAt; changeable = False; vote
      previous = None; previousV1 = None; featuredAppRight = None
  setTime (addRelTime p.closesAt (days 1))
  settled <- submit f.provider do
    exerciseCmd proposal Proposal_Tally with ballots = []; final = True; cast = Some [ballot]
  Some result <- queryContractId f.provider settled
  assert (result.outcome == Some outcome)
  pure settled

pass : Fixtures.Founded -> ContractId Member -> ContractId Proposal -> Script (ContractId Proposal)
pass f member proposal = passWith f member proposal Yes Passed

execute : Fixtures.Founded -> ContractId DAO -> ContractId Proposal -> [ContractId Member] -> Int -> Script (Optional (ContractId DAO))
execute f dao proposal current upTo = submit f.provider do
  exerciseCmd dao DAO_Execute with proposal; current; upTo; featuredAppRight = None

retain : Optional (ContractId DAO) -> Script (ContractId DAO)
retain result = case result of
  Some cid -> pure cid
  None -> abort "A non-dissolution must retain the DAO"

-- | A party's own membership, since the DAO's creator sees every member of it.
membership : Party -> Party -> Script (ContractId Member, Member)
membership reader party = do
  found <- query @Member reader
  case filter (\(_, m) -> m.party == party) found of
    [one] -> pure one
    _ -> abort "Expected exactly one membership for this party"

-- | Reshare the founder and admit new members in batches, then remove one by a later vote.
-- | Invalid batches roll back the proposal's progress as well as the DAO's state.
shareBatches : Script ()
shareBatches = script do
  f <- Fixtures.foundWith False (Fixtures.openSettings with rule = Fixtures.openRule with basis = OfCast) Fixtures.openSettings
  (joiner, _) <- Fixtures.onboard f.provider "joiner"
  (outsider, outsiderAccount) <- Fixtures.onboard f.provider "outsider"
  otherDao <- submit outsider do
    exerciseCmd outsiderAccount Account_CreateDAO with
      id = "other"; daoName = "Other"; description = ""; image = None
      equal = False; rules = Fixtures.openSettings; decisions = Fixtures.openSettings
      shares = [(outsider, 1)]; more = []; actorPays = False
      public = True; featuredAppRight = None
  Some _ <- queryContractId f.provider otherDao
  [(otherMember, _)] <- query @Member outsider
  p <- propose f f.dao f.member "shares" (SetShares [(f.founder, 3), (joiner, 2), (outsider, 4)])
  passed <- pass f f.member p
  Fixtures.refuses f.provider "The batch must move on" do
    exerciseCmd f.dao DAO_Execute with proposal = passed; current = []; upTo = 0; featuredAppRight = None
  [(votedMember, _)] <- query @Member f.founder
  Fixtures.refuses f.provider "A member handed in twice" do
    exerciseCmd f.dao DAO_Execute with proposal = passed; current = [votedMember, votedMember]; upTo = 2; featuredAppRight = None
  Fixtures.refuses f.provider "Not a member of this DAO" do
    exerciseCmd f.dao DAO_Execute with proposal = passed; current = [otherMember]; upTo = 3; featuredAppRight = None
  Some before <- queryContractId f.provider passed
  assert (before.executed == 0 && before.executedAt == None)
  first <- retain =<< execute f f.dao passed [votedMember] 2
  Some intermediate <- queryContractId f.provider first
  assert (intermediate.members == 2 && intermediate.units == 5)
  None <- queryContractId f.provider votedMember
  (founderMember, founderRecord) <- membership f.founder f.founder
  assert (founderRecord.share == 3 && founderRecord.shareSince >= founderRecord.since)
  (joinerMember, joinerRecord) <- membership joiner joiner
  assert (joinerRecord.share == 2 && joinerRecord.daoId == "dao")
  -- The proposal that was advanced is a new contract, with the batch recorded on it.
  [(progressId, progress)] <- query @Proposal f.provider
  assert (progress.executed == 2 && progress.executedAt == None)
  Fixtures.refuses f.provider "The batch must move on" do
    exerciseCmd first DAO_Execute with proposal = progressId; current = []; upTo = 2; featuredAppRight = None
  Fixtures.refuses f.provider "A member not in this batch" do
    exerciseCmd first DAO_Execute with proposal = progressId; current = [founderMember]; upTo = 3; featuredAppRight = None
  last <- retain =<< execute f first progressId [] 3
  Some completed <- queryContractId f.provider last
  assert (completed.members == 3 && completed.units == 9)
  [(finishedId, finished)] <- query @Proposal f.provider
  assert (finished.executed == 3 && finished.executedAt /= None)
  -- A share change that is fully carried out is out of batches before its proposal is consulted,
  -- so the batch guard, not `Proposal_Advance`'s "Already executed", is what Fixtures.refuses a repeat.
  Fixtures.refuses f.provider "The batch must move on" do
    exerciseCmd last DAO_Execute with proposal = finishedId; current = []; upTo = 3; featuredAppRight = None
  removal <- propose f last founderMember "remove" (SetShares [(joiner, 0)])
  removalPassed <- pass f founderMember removal
  next <- retain =<< execute f last removalPassed [joinerMember] 1
  Some reduced <- queryContractId f.provider next
  assert (reduced.members == 2 && reduced.units == 7)
  None <- queryContractId joiner joinerMember
  pure ()

-- | Each effect that rewrites the DAO writes exactly its own fields, and leaves the rest standing.
effectsRewriteTheDao : Script ()
effectsRewriteTheDao = script do
  f <- Fixtures.found
  let strict = Settings with rule = (Fixtures.openRule with threshold = Percent 80); votingDays = 5
      loose = Settings with rule = (Fixtures.openRule with quorum = 25); votingDays = 2
      step dao member pid action = do
        p <- propose f dao member pid action
        settled <- pass f member p
        cid <- retain =<< execute f dao settled [] 1
        Some live <- queryContractId f.provider cid
        (next, _) <- membership f.founder f.founder
        pure (cid, next, live)
  (afterSignal, m1, signalled) <- step f.dao f.member "signal" Signal
  assert (signalled.name == "Test DAO" && signalled.public && signalled.rules == Fixtures.openSettings)
  (afterChoice, m2, chosen) <- do
    p <- propose f afterSignal m1 "choice" (Choose with options = ["A", "B"]; several = False)
    settled <- passWith f m1 p (Pick 1) (Chosen 1)
    cid <- retain =<< execute f afterSignal settled [] 1
    Some live <- queryContractId f.provider cid
    (next, _) <- membership f.founder f.founder
    pure (cid, next, live)
  assert (chosen.name == "Test DAO" && chosen.decisions == Fixtures.openSettings)
  (afterInfo, m3, renamed) <- step afterChoice m2 "info"
    (SetInfo with daoName = "Renamed"; description = "Said so"; image = Some "https://example.org/a.png")
  assert (renamed.name == "Renamed" && renamed.description == "Said so")
  assert (renamed.image == Some "https://example.org/a.png")
  assert (renamed.members == 1 && renamed.units == 1 && renamed.createdAt == signalled.createdAt)
  (afterRules, m4, stricter) <- step afterInfo m3 "rules" (SetRules with rules = strict)
  assert (stricter.rules == strict && stricter.decisions == Fixtures.openSettings)
  assert (stricter.name == "Renamed")
  (afterPublic, m5, closed) <- step afterRules m4 "public" (SetPublic with public = False)
  assert (not closed.public && closed.rules == strict)
  -- A proposal under the strict rules still passes on the founder's whole vote.
  (afterSettings, _, both) <- step afterPublic m5 "settings"
    (SetSettings with rules = Fixtures.openSettings; decisions = loose)
  assert (both.rules == Fixtures.openSettings && both.decisions == loose)
  assert (not both.public && both.name == "Renamed")
  [(_, lastProposal)] <- pure . filter (\(_, p) -> p.id == "settings") =<< query @Proposal f.provider
  assert (lastProposal.executed == 1 && lastProposal.executedAt /= None)
  Some stillThere <- queryContractId f.provider afterSettings
  assert (stillThere.id == "dao")

-- | A dissolution waits before it takes effect: the DAO stops taking proposals, then goes.
dissolution : Script ()
dissolution = script do
  f <- Fixtures.found
  pending <- propose f f.dao f.member "open" Signal
  dissolve <- propose f f.dao f.member "dissolve" Dissolve
  Fixtures.refuses f.provider "Not a dissolution that passed" do
    exerciseCmd f.dao DAO_BeginDissolving with proposal = dissolve
  (voter, _) <- membership f.founder f.founder
  Some openProposal <- queryContractId f.provider pending
  openBallot <- submit f.founder do
    exerciseCmd voter Member_Cast with
      proposalId = "open"; closesAt = openProposal.closesAt; changeable = False
      vote = Yes; previous = None; previousV1 = None; featuredAppRight = None
  (nextVoter, _) <- membership f.founder f.founder
  passed <- pass f nextVoter dissolve
  Fixtures.refuses f.provider "Not a dissolution that passed" do
    exerciseCmd f.dao DAO_BeginDissolving with proposal = pending
  dissolving <- submit f.provider do
    exerciseCmd f.dao DAO_BeginDissolving with proposal = passed
  Some waiting <- queryContractId f.provider dissolving
  assert (waiting.dissolving /= None && waiting.id == "dao" && waiting.members == 1)
  Fixtures.refuses f.provider "Already dissolving" do
    exerciseCmd dissolving DAO_BeginDissolving with proposal = passed
  -- Nothing new is proposed while it waits, so the wait has an end.
  (member, _) <- membership f.founder f.founder
  Fixtures.refuses f.founder "The DAO is being dissolved; nothing new can be proposed" do
    exerciseCmd member Member_Propose with
      dao = dissolving; pid = "late"; title = "Too late"; description = ""
      action = Signal; rule = None; votingDays = None; featuredAppRight = None
  -- The ballot cast while it was open is still counted, and the proposal is carried out.
  openPassed <- submit f.provider do
    exerciseCmd pending Proposal_Tally with ballots = []; final = True; cast = Some [openBallot]
  Some opened <- queryContractId f.provider openPassed
  assert (opened.outcome == Some Passed)
  surviving <- retain =<< execute f dissolving openPassed [] 1
  Some live <- queryContractId f.provider surviving
  assert (live.dissolving == waiting.dissolving)
  [(dissolvePassed, _)] <- pure . filter (\(_, p) -> p.id == "dissolve") =<< query @Proposal f.provider
  gone <- submit f.provider do
    exerciseCmd surviving DAO_Execute with
      proposal = dissolvePassed; current = []; upTo = 1; featuredAppRight = None
  case gone of
    Some _ -> abort "A dissolution must return no DAO"
    None -> pure ()
  [] <- query @DAO f.provider
  -- The memberships of a dissolved DAO are not swept with it; they outlive the DAO contract.
  (_, orphan) <- membership f.founder f.founder
  assert (orphan.daoId == "dao")

-- | A DAO's authority is its creator and provider together: neither executes alone, and only this
-- DAO's own proposals move it.
executionAuthority : Script ()
executionAuthority = script do
  f <- Fixtures.found
  (outsider, outsiderAccount) <- Fixtures.onboard f.provider "outsider"
  theirDao <- submit outsider do
    exerciseCmd outsiderAccount Account_CreateDAO with
      id = "dao"; daoName = "Same id, other authority"; description = ""; image = None
      equal = True; rules = Fixtures.openSettings; decisions = Fixtures.openSettings
      shares = [(outsider, 1)]; more = []; actorPays = False
      public = True; featuredAppRight = None
  (theirMember, _) <- membership outsider outsider
  theirs <- submit outsider do
    exerciseCmd theirMember Member_Propose with
      dao = theirDao; pid = "theirs"; title = "Theirs"; description = ""
      action = Signal; rule = None; votingDays = None; featuredAppRight = None
  Some theirProposal <- queryContractId f.provider theirs
  theirBallot <- submit outsider do
    exerciseCmd theirMember Member_Cast with
      proposalId = "theirs"; closesAt = theirProposal.closesAt; changeable = False
      vote = Yes; previous = None; previousV1 = None; featuredAppRight = None
  setTime (addRelTime theirProposal.closesAt (days 1))
  theirSettled <- submit f.provider do
    exerciseCmd theirs Proposal_Tally with ballots = []; final = True; cast = Some [theirBallot]
  -- A passed proposal of a DAO of the same id, under another creator, moves nothing here.
  Fixtures.refuses f.provider "Not this DAO's proposal" do
    exerciseCmd f.dao DAO_Execute with
      proposal = theirSettled; current = []; upTo = 1; featuredAppRight = None
  Fixtures.refuses f.provider "Not this DAO's proposal" do
    exerciseCmd f.dao DAO_BeginDissolving with proposal = theirSettled
  mine <- propose f f.dao f.member "mine" Signal
  Fixtures.refuses f.provider "The proposal did not pass" do
    exerciseCmd f.dao DAO_Execute with proposal = mine; current = []; upTo = 1; featuredAppRight = None
  (voter, _) <- membership f.founder f.founder
  failed <- passWith f voter mine No Failed
  Fixtures.refuses f.provider "The proposal did not pass" do
    exerciseCmd f.dao DAO_Execute with proposal = failed; current = []; upTo = 1; featuredAppRight = None
  -- Executing is the provider's, with the DAO's authority; the creator alone cannot.
  (member, _) <- membership f.founder f.founder
  second <- propose f f.dao member "second" Signal
  settled <- pass f member second
  Fixtures.refuses f.founder "requires authorizers" do
    exerciseCmd f.dao DAO_Execute with proposal = settled; current = []; upTo = 1; featuredAppRight = None
  Fixtures.refuses f.founder "requires authorizers" do
    exerciseCmd f.dao DAO_BeginDissolving with proposal = settled
  -- Progress is the DAO's to record: the provider cannot advance a proposal by itself.
  Fixtures.refuses f.provider "requires authorizers" do
    exerciseCmd settled Proposal_Advance with upTo = 1
  Fixtures.refusesAll [f.provider, f.founder] "Progress only goes forward" do
    exerciseCmd settled Proposal_Advance with upTo = 2
  carried <- retain =<< execute f f.dao settled [] 1
  Some live <- queryContractId f.provider carried
  assert (live.id == "dao")
  [(advanced, record)] <- pure . filter (\(_, p) -> p.id == "second") =<< query @Proposal f.provider
  assert (record.executed == 1 && record.executedAt /= None)
  Fixtures.refusesAll [f.provider, f.founder] "Already executed" do
    exerciseCmd advanced Proposal_Advance with upTo = 1
  Fixtures.refuses f.provider "Already settled" do
    exerciseCmd advanced Proposal_Tally with ballots = []; final = True; cast = None
