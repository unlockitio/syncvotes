-- | Statements record the provider's figures rather than holding coin; only that provider may
-- rewrite one, and a rewrite consumes the old statement.
module SyncVotes.Tests.Billing where

import Daml.Script
import DA.Time (addRelTime, days)
import SyncVotes.Billing (Meter (..), Meter_Update (..), Purse (..), Purse_Update (..))
import qualified SyncVotes.Tests.Fixtures as Fixtures

-- | Only the provider can archive meter and purse statements; both disappear afterward.
archiveStatements : Script ()
archiveStatements = script do
  provider <- allocateParty "provider"
  customer <- allocateParty "customer"
  now <- getTime
  meter <- submit provider do
    createCmd Meter with
      provider; daoId = "dao"; credited = 5.0; charged = 1.0; updatedAt = now
  purse <- submit provider do
    createCmd Purse with
      provider; fingerprint = "customer"; party = Some customer
      credited = 7.0; charged = 2.0; updatedAt = now
  m <- Fixtures.assertLiveContract "meter" provider meter
  p <- Fixtures.assertLiveContract "purse" provider purse
  Fixtures.assertEquals "meter balance" 4.0 (m.credited - m.charged)
  Fixtures.assertEquals "purse party" (Some customer) p.party
  trySubmit (actAs customer <> readAs provider) (do
    exerciseCmd purse Archive) >>= Fixtures.because "requires authorizers"
  _ <- Fixtures.assertLiveContract "purse" provider purse
  submit provider do exerciseCmd meter Archive
  submit provider do exerciseCmd purse Archive
  Fixtures.assertArchivedContract "meter" provider meter
  Fixtures.assertArchivedContract "purse" provider purse
  Fixtures.assertQueryCount "remaining meters" 0 =<< query @Meter provider
  Fixtures.assertQueryCount "remaining purses" 0 =<< query @Purse provider

-- | Only provider updates replace statements, preserving keys and recording new amounts and time.
statements : Script ()
statements = script do
  provider <- allocateParty "provider"
  customer <- allocateParty "customer"
  stranger <- allocateParty "stranger"
  now <- getTime
  meter <- submit provider do
    createCmd Meter with
      provider; daoId = "dao"; credited = 0.0; charged = 0.0; updatedAt = now
  purse <- submit provider do
    createCmd Purse with
      provider; fingerprint = "fingerprint"; party = None
      credited = 0.0; charged = 0.0; updatedAt = now
  -- The statement is the provider's: the party named in a purse is not its controller.
  trySubmit (actAs customer <> readAs provider) (do
    exerciseCmd purse Purse_Update with newParty = Some customer; newCredited = 5.0; newCharged = 0.5)
    >>= Fixtures.because "requires authorizers"
  trySubmit (actAs stranger <> readAs provider) (do
    exerciseCmd meter Meter_Update with newCredited = 10.0; newCharged = 1.0)
    >>= Fixtures.because "requires authorizers"
  setTime (addRelTime now (days 1))
  nextMeter <- submit provider do
    exerciseCmd meter Meter_Update with newCredited = 10.25; newCharged = 1.5
  nextPurse <- submit provider do
    exerciseCmd purse Purse_Update with newParty = Some customer; newCredited = 5.0; newCharged = 0.75
  Fixtures.assertArchivedContract "meter" provider meter
  Fixtures.assertArchivedContract "purse" provider purse
  m <- Fixtures.assertLiveContract "updated meter" provider nextMeter
  p <- Fixtures.assertLiveContract "updated purse" provider nextPurse
  Fixtures.assertEquals "meter DAO" "dao" m.daoId
  Fixtures.assertEquals "meter provider" provider m.provider
  Fixtures.assertEquals "meter credit" 10.25 m.credited
  Fixtures.assertEquals "meter charge" 1.5 m.charged
  Fixtures.assertEquals "meter balance" 8.75 (m.credited - m.charged)
  Fixtures.assertCondition "meter updated after creation" (m.updatedAt > now)
  Fixtures.assertEquals "meter update time" (addRelTime now (days 1)) m.updatedAt
  Fixtures.assertEquals "purse fingerprint" "fingerprint" p.fingerprint
  Fixtures.assertEquals "purse party" (Some customer) p.party
  Fixtures.assertEquals "purse provider" provider p.provider
  Fixtures.assertEquals "purse credit" 5.0 p.credited
  Fixtures.assertEquals "purse charge" 0.75 p.charged
  Fixtures.assertEquals "purse balance" 4.25 (p.credited - p.charged)
  assert (p.updatedAt > now)
  -- A later update changes the recorded amounts and party without altering the key.
  finalPurse <- submit provider do
    exerciseCmd nextPurse Purse_Update with
      newParty = None; newCredited = 7.0; newCharged = 2.0
  Fixtures.assertArchivedContract "previous purse" provider nextPurse
  final <- Fixtures.assertLiveContract "final purse" provider finalPurse
  Fixtures.assertEquals "final purse party" None final.party
  Fixtures.assertEquals "final purse fingerprint" "fingerprint" final.fingerprint
  Fixtures.assertEquals "final purse credit" 7.0 final.credited
  Fixtures.assertEquals "final purse charge" 2.0 final.charged
  (onlyMeter, _) <- Fixtures.assertSingleResult "remaining meter" =<< query @Meter provider
  (onlyPurse, _) <- Fixtures.assertSingleResult "remaining purse" =<< query @Purse provider
  Fixtures.assertEquals "remaining meter id" nextMeter onlyMeter
  Fixtures.assertEquals "remaining purse id" finalPurse onlyPurse
