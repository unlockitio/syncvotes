-- SPDX-License-Identifier: MIT
-- Independent SyncVotes lineage. Shapes mirror SyncVotes.Types, not its templates or DAR.
module SyncVotes.Concordia.Types where

data Vote = Yes | No | Abstain | Pick Int | PickMany [Int]
  deriving (Eq, Show)

data Outcome = Passed | Failed | Chosen Int | ChosenMany [Int]
  deriving (Eq, Show)

data Effect
  = Signal
  | Choose with options : [Text]; several : Bool
  | SetShares with changes : [(Party, Int)]
  | SetInfo with daoName : Text; description : Text; image : Optional Text
  | SetRules with rules : Settings
  | SetPublic with public : Bool
  | Dissolve
  | SetSettings with rules : Settings; decisions : Settings
  deriving (Eq, Show)

data Basis = OfAll | OfCast deriving (Eq, Show)
data Threshold = Majority | Percent Int | Fraction with num : Int; den : Int
  deriving (Eq, Show)
data Rule = Rule with
    basis : Basis
    threshold : Threshold
    quorum : Int
    early : Bool
    changeable : Bool
    secret : Bool
  deriving (Eq, Show)
data Settings = Settings with rule : Rule; votingDays : Int
  deriving (Eq, Show)
